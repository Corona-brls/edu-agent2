APP_NAME=course-agent
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
KNOWLEDGE_BASE_DIR=knowledge_base
SQLITE_DB_PATH=backend/data/app.db

# Comma-separated positive course IDs. Leave empty by default. Add a course only
# after the course owner has explicitly approved third-party model processing,
# including the provider, purpose, and revocation procedure.
EXTERNAL_MODEL_COURSE_ALLOWLIST=

# Phase 2: vector knowledge base
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_DIR=backend/data/vector_store
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RETRIEVAL_KEYWORD_WEIGHT=0.45
RETRIEVAL_VECTOR_WEIGHT=0.55
RETRIEVAL_MIN_SCORE=0.18

# Phase 2: MCP
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=mcp_server/server.py
MCP_TRANSPORT=stdio
MCP_TOOL_TIMEOUT_SECONDS=30

# Phase 2: LLM provider
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_FALLBACK_PROVIDER=template
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS=3
AGENT_TIMEOUT_SECONDS=120
AGENT_ALLOW_ASK_USER=true

# Phase 2: feature switches
ENABLE_VECTOR_RETRIEVAL=true
ENABLE_MCP_SERVER=false
# Deprecated/no-op: FastAPI lifespan owns the single MCP child process.
ENABLE_AGENT_TRACES=true
ENABLE_REAL_PAPER_SEARCH=false
ENABLE_REAL_CVE_LOOKUP=false
ENABLE_REAL_STANDARD_FETCH=false
# Deprecated/no-op: use ENABLE_REAL_RFC_LOOKUP for RFC Editor metadata.
ENABLE_REAL_RFC_LOOKUP=false

# Phase 2: optional external APIs
OPENAI_API_KEY=
QWEN_API_KEY=
NVD_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Phase 3: identity, roles, and course context
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENABLE_DEMO_ACCOUNTS=true
DEFAULT_COURSE_ID=demo-course
DEFAULT_CLASS_ID=demo-class
COURSE_AGENT_ROLE=student

# Phase 3: external connector gateway
EXTERNAL_CONNECTOR_MODE=hybrid
EXTERNAL_CACHE_TTL_HOURS=24
EXTERNAL_HTTP_TIMEOUT_SECONDS=20
EXTERNAL_HTTP_MAX_RETRIES=2
EXTERNAL_RESOURCE_INDEX_ENABLED=false
ENABLE_SEMANTIC_SCHOLAR=false
ENABLE_ARXIV=false
ENABLE_NVD=false
ENABLE_GITHUB_SEARCH=false
GITHUB_TOKEN=
ENABLE_STANDARD_REMOTE_METADATA=true
STANDARD_DOCUMENT_MODE=uploaded_local

# Phase 3: resource cache
RESOURCE_CACHE_DIR=backend/data/resource_cache
RESOURCE_CACHE_MAX_ITEMS=10000
CONNECTOR_SYNC_BATCH_SIZE=20
CONNECTOR_LIVE_SMOKE_ENABLED=false

# Phase 3: question clustering
QUESTION_CLUSTER_AUTO_THRESHOLD=3
QUESTION_CLUSTER_MIN_SIZE=2
QUESTION_CLUSTER_DISTANCE_THRESHOLD=0.35
QUESTION_CLUSTER_LOOKBACK_DAYS=90
QUESTION_CLUSTER_MODEL=existing-embedding
QUESTION_CLUSTER_ALLOW_TEACHER_OVERRIDE=true

# Phase 3: learning events and activity tracking
LEARNING_EVENT_RETENTION_DAYS=365
SESSION_IDLE_TIMEOUT_MINUTES=30
ACTIVITY_HEARTBEAT_SECONDS=60
ENABLE_LEARNING_EVENT_LOG=true
